<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles.uss?fileID=7433441132597879392&amp;guid=1cedb3ec60f753d4cb792f3ac22e8ff8&amp;type=3#Styles"/>
    <ui:VisualElement name="PlayerHeatlh" style="flex-grow: 0; width: initial; height: initial; flex-direction: row; align-items: stretch; justify-content: center; align-content: flex-start; align-self: flex-start; position: absolute; top: 20px; left: 20px;">
        <ui:VisualElement name="SheriffImage" style="flex-grow: initial; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0); width: 75px; height: 75px; background-image: url(&quot;project://database/Assets/Sprites/UI/SheriffIcon1.png?fileID=-1261936601765289252&amp;guid=65d6cf0a995cb724faf2781d3578ab6f&amp;type=3#sheriffIcon2_0&quot;); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;"/>
        <ui:Label text="100" name="PlayerHealthValue" style="font-size: 75px; -unity-font-style: normal; color: rgb(202, 9, 9); -unity-font-definition: url(&quot;project://database/Assets/Sprites/UI/Rye-Regular.ttf?fileID=12800000&amp;guid=fb2f1cbb70783394b83935151f09e9ff&amp;type=3#Rye-Regular&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
        <ui:VisualElement name="HeartImage" style="flex-grow: 1; width: 75px; height: 75px; background-image: url(&quot;project://database/Assets/Sprites/UI/heart.png?fileID=-205270267638800340&amp;guid=752890bc6ada75c45b6cac2c10f3f978&amp;type=3#heart_0&quot;); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="EnemyCount" style="flex-grow: 0; width: 250px; height: 250px; flex-direction: column; align-items: center; align-self: flex-start; position: absolute; right: 20px; top: 20px; left: initial; background-image: url(&quot;project://database/Assets/Sprites/UI/WantedPoster.png?fileID=4269249896398512438&amp;guid=82229f7a4ada58f4f99adb9fb3b9eae8&amp;type=3#WantedPoster_0&quot;); background-size: 100% 100%; justify-content: space-evenly; bottom: initial;">
        <ui:Label text="WANTED" name="Wanted" style="-unity-font-definition: url(&quot;project://database/Assets/Sprites/UI/Smokum-Regular.ttf?fileID=12800000&amp;guid=798288e8467684347a67fe6ab1189f11&amp;type=3#Smokum-Regular&quot;); font-size: 80px;"/>
        <ui:Label text="1" name="EnemyCountValue" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-grow: 0; width: auto; -unity-font-definition: url(&quot;project://database/Assets/Sprites/UI/Smokum-Regular.ttf?fileID=12800000&amp;guid=798288e8467684347a67fe6ab1189f11&amp;type=3#Smokum-Regular&quot;); font-size: 60px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="EndScreen" class="menuContainer" style="flex-grow: 1; top: 0; left: 0; bottom: 0; right: 0; opacity: 0; transition-property: opacity; transition-duration: 1s; transition-timing-function: ease-in; display: none;">
        <ui:Label text="Label" name="EndScreenText" class="title"/>
        <ui:Button text="Retry" name="RetryButton" class="button"/>
        <ui:Button text="Exit To Menu" name="ExitToMenuButton" class="button"/>
    </ui:VisualElement>
</ui:UXML>
